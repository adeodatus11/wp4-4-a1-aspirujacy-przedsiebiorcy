{
  "name": "pracownia-lekcje",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interaktywne lekcje handlu i przedsiębiorczości (HAN.01, HAN.02) dla szkoły i dorosłych",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/export-catalog.mjs && vite build",
